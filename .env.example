# AI Model Configuration
# Supports any model through LiteLLM:
#   - Anthropic: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022
#   - OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
#   - Local (Ollama): ollama/llama3, ollama/mistral, ollama/codellama
#   - And many more: gemini/*, cohere/*, bedrock/*, etc.
AI_MODEL=claude-sonnet-4-20250514

# API Key for cloud providers (not needed for local models like Ollama)
# For backward compatibility, ANTHROPIC_API_KEY is also supported
AI_API_KEY=your_api_key_here

# Path to your Obsidian vault
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# Daily notes folder (relative to vault path)
DAILY_NOTES_FOLDER=Daily Notes

# Knowledge repository folder (relative to vault path)
KNOWLEDGE_REPO_FOLDER=Knowledge Base

# Number of days to look back for new notes
LOOKBACK_DAYS=1

# Content Scrapers Configuration
# Enable/disable LessWrong scraper
LESSWRONG_ENABLED=true
# Number of top LessWrong posts to fetch
LESSWRONG_POST_COUNT=5

# RSS Feeds (comma-separated list of RSS/Atom feed URLs)
# Examples:
#   - Hacker News: https://news.ycombinator.com/rss
#   - Arxiv AI: http://export.arxiv.org/rss/cs.AI
#   - Your blog: https://yourblog.com/feed
RSS_FEEDS=https://news.ycombinator.com/rss,http://export.arxiv.org/rss/cs.AI
# Number of items to fetch per RSS feed
RSS_ITEMS_PER_FEED=5
